    - target: {fileID: 8537694587191430970, guid: 1429a5510069a324b8a5b9c003c0d5b6, type: 3}
      propertyPath: m_Name
      value: Spine GameObject (skeleton)
      objectReference: {fileID: 0}
    - target: {fileID: 8816886512531454252, guid: 1429a5510069a324b8a5b9c003c0d5b6, type: 3}
      propertyPath: talked
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8816886512531454252, guid: 1429a5510069a324b8a5b9c003c0d5b6, type: 3}
      propertyPath: dialogue.sentences.Array.size
      value: 11
      objectReference: {fileID: 0}
    - target: {fileID: 8816886512531454252, guid: 1429a5510069a324b8a5b9c003c0d5b6, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: Hissediyor musun?
      objectReference: {fileID: 0}
    - target: {fileID: 8816886512531454252, guid: 1429a5510069a324b8a5b9c003c0d5b6, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "So\u011Fuklu\u011Fu..."
      objectReference: {fileID: 0}
    - target: {fileID: 8816886512531454252, guid: 1429a5510069a324b8a5b9c003c0d5b6, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "Ona yakla\u015F\u0131yorsun..."
      objectReference: {fileID: 0}
    - target: {fileID: 8816886512531454252, guid: 1429a5510069a324b8a5b9c003c0d5b6, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: "Biliyorum dostum cesur ve g\xFC\xE7l\xFCs\xFCn fakat..."
      objectReference: {fileID: 0}
    - target: {fileID: 8816886512531454252, guid: 1429a5510069a324b8a5b9c003c0d5b6, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[4]'
      value: "Bu yol daha da zorla\u015Facak."
      objectReference: {fileID: 0}
    - target: {fileID: 8816886512531454252, guid: 1429a5510069a324b8a5b9c003c0d5b6, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[5]'
      value: "\u0130leride kar\u015F\u0131na baz\u0131 ki\u015Filer \xE7\u0131kacak..."
      objectReference: {fileID: 0}
    - target: {fileID: 8816886512531454252, guid: 1429a5510069a324b8a5b9c003c0d5b6, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[6]'
      value: "Bizim gibi \xF6l\xFCm\xFC reddetmi\u015F ama ona kul olmu\u015F ki\u015Filer..."
      objectReference: {fileID: 0}
    - target: {fileID: 8816886512531454252, guid: 1429a5510069a324b8a5b9c003c0d5b6, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[7]'
      value: "Seni durdurmaya \xE7al\u0131\u015Facaklar."
      objectReference: {fileID: 0}
    - target: {fileID: 8816886512531454252, guid: 1429a5510069a324b8a5b9c003c0d5b6, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[8]'
      value: "Ve emin ol sand\u0131\u011F\u0131ndan \xE7ok daha g\xFC\xE7l\xFCler."
      objectReference: {fileID: 0}
    - target: {fileID: 8816886512531454252, guid: 1429a5510069a324b8a5b9c003c0d5b6, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[9]'
      value: Yinede korkma. Devam et.
      objectReference: {fileID: 0}
    - target: {fileID: 8816886512531454252, guid: 1429a5510069a324b8a5b9c003c0d5b6, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[10]'
      value: "Zaten ba\u015Fka \u015Fans\u0131m\u0131z yok..."
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 1429a5510069a324b8a5b9c003c0d5b6, type: 3}

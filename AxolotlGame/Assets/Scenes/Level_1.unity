      value: 333453627
      objectReference: {fileID: 0}
    - target: {fileID: 6644236201580938964, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: m_Name
      value: Semender
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[0]'
      value: "S\u0131cakl\u0131\u011F\u0131 hissediyor musun? Kavurucu s\u0131cakl\u0131\u011F\u0131..."
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[1]'
      value: "Bu sessiz, karanl\u0131k hi\xE7likten cehenneme ge\xE7mek \xFCzere
        oldu\u011Funun habercisi."
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "Arafta yanl\u0131z olabiliriz ama... Bu yolun ilerisinde tek biz olmayaca\u011F\u0131z."
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: "Yolu benim i\xE7in a\xE7 ki dostum sana yol g\xF6stericilik yapay\u0131m."
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[4]'
      value: "Buradan ayr\u0131ld\u0131\u011F\u0131n an \xF6l\xFCm pe\u015Fine d\xFC\u015Fecek.
        Onu iliklerine kadar hissedeceksin."
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[5]'
      value: "H\u0131zl\u0131 ol..."
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[6]'
      value: Seni yakalarsa...
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[7]'
      value: "Buraya geri d\xF6nersin. En ba\u015Fa."
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[8]'
      value: "\u0130\u015Fte bu d\xF6ng\xFC. Biz fanileri \xE7\u0131ld\u0131rt\u0131r.
        Yorar. T\u0131pk\u0131 benim gibi."
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[9]'
      value: "\u0130lerle dostum! Kim oldu\u011Funu neden burda oldu\u011Funu ke\u015Ffet!
        Ve e\u011Fer \xF6l\xFCmle kar\u015F\u0131 kar\u015F\u0131ya gelirsen \u015Fu
        s\xF6zleri hayk\u0131r ona!"
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[10]'
      value: Seni Reddediyorum!
      objectReference: {fileID: 0}
    - target: {fileID: 8697876347487872743, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: m_Size.x
      value: 4.3255877
      objectReference: {fileID: 0}
    - target: {fileID: 8697876347487872743, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: m_Size.y
      value: 7.398163
      objectReference: {fileID: 0}

  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3fe52df55ea164641b4a9ebbf833acc6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogue:
    name: Semender
    sentences:
    - "Sen... Nas\u0131l?"
    - "Bu kadar kolay bir \u015Fekilde buraya gelebilmen..."
    - "Y\xFCzlerce y\u0131l sonra ilk defa bana bir \u015Feyler hissettirdin dostum..."
    - Umut
    - "Sen farkl\u0131s\u0131n... Daha iyisin. Belki... Belki bir yolunu bulursun."
    - "Belki de buras\u0131 sonu olmayan bir hi\xE7lik de\u011Fildir."
    - "Benim gibi umudunu yitirme yolda\u015F\u0131m. Benim kadar g\xFC\xE7s\xFCz
      olma!"
    - "Buradan \xE7\u0131kman\u0131n bir yolu elbette var. Fakat..."
    - "Fakat bizim gibi faniler i\xE7in neredeyse imkans\u0131z."
    - "Yinede bu durumda iken, imkans\u0131z\u0131 denemek pek de aptalca de\u011Fil."
    - "Senin sayende bir ama\xE7 edindim dostum. Sana yolda\u015Fl\u0131k edece\u011Fim
      ve yol g\xF6sterece\u011Fim."
    - "Ben belki ba\u015Faramad\u0131m. Fakat sen benim gibi yanl\u0131z olmayacaks\u0131n."
    - "Buradan \xE7\u0131kman\u0131n tek bir yolu var."
    - "Hep yukar\u0131 t\u0131rman!"
  spineAnim: {fileID: 466132148}
  talked: 0

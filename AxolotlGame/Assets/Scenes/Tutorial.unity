      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[2]'
      value: "Y\xFCzlerce y\u0131l sonra ilk defa bana bir \u015Feyler hissettirdin
        dostum..."
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[3]'
      value: Umut
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[4]'
      value: "Sen farkl\u0131s\u0131n... Daha iyisin. Belki... Belki bir yolunu bulursun."
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[5]'
      value: "Belki de buras\u0131 sonu olmayan bir hi\xE7lik de\u011Fildir."
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[6]'
      value: "Benim gibi umudunu yitirme yolda\u015F\u0131m. Benim kadar g\xFC\xE7s\xFCz
        olma!"
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[7]'
      value: "Buradan \xE7\u0131kman\u0131n bir yolu elbette var. Fakat..."
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[8]'
      value: "Fakat bizim gibi faniler i\xE7in neredeyse imkans\u0131z."
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[9]'
      value: "Yinede bu durumda iken, imkans\u0131z\u0131 denemek pek de aptalca
        de\u011Fil."
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[10]'
      value: "Senin sayende bir ama\xE7 edindim dostum. Sana yolda\u015Fl\u0131k
        edece\u011Fim ve yol g\xF6sterece\u011Fim."
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[11]'
      value: "Ben belki ba\u015Faramad\u0131m. Fakat sen benim gibi yanl\u0131z olmayacaks\u0131n."
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[12]'
      value: "Buradan \xE7\u0131kman\u0131n tek bir yolu var."
      objectReference: {fileID: 0}
    - target: {fileID: 7370409122364952569, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
      propertyPath: 'dialogue.sentences.Array.data[13]'
      value: "Hep yukar\u0131 t\u0131rman!"
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents: []
  m_SourcePrefab: {fileID: 100100000, guid: 963350c9993ce7b48a370ebcfeefc0fc, type: 3}
